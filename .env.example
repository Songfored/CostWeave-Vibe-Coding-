# CostWeave local development profile.
# Copy this file to .env.local.  The local file is ignored by Git.

# Keep mutable data inside the ignored work/ directory so the repository stays clean.
COSTWEAVE_CATALOG_PATH=work/local-data/model_catalog.json
COSTWEAVE_RUNTIME_DB=work/local-data/runtime-v4.sqlite3

# Enable the complete offline v0.6 control plane.
COSTWEAVE_CONTRACTS_V4=1
COSTWEAVE_RUNTIME_V4=1
COSTWEAVE_ARTIFACT_DAG=1
COSTWEAVE_PARALLEL_RUNTIME=1
COSTWEAVE_PLACEMENT_V4=1
COSTWEAVE_EVIDENCE_RECOVERY=1
COSTWEAVE_OUTCOME_FORECAST=1
COSTWEAVE_MEDIA_WORKFLOW=1
COSTWEAVE_HANDOFF_INTELLIGENCE=1
COSTWEAVE_SCHEDULER_POLICY=critical-path

# Safety gates.  Keep these disabled for normal local development.
COSTWEAVE_EXPERIMENTAL_ADAPTERS=0
COSTWEAVE_PAID_CALLS=0
COSTWEAVE_CANARY_ENABLED=0

# Generated non-secret provider registry. Run scripts/configure-models.ps1;
# do not fill endpoint URLs or model names by hand.
COSTWEAVE_PROVIDER_REGISTRY=work/local-data/providers.local.json

# Never commit provider credentials.  Adding a key alone is not enough to make
# a real call: v0.6.9 still needs the trusted executor described in
# docs/REAL_MODEL_EVALUATION.md.  Add provider variables only to .env.local:
# COSTWEAVE_DEEPSEEK_API_KEY=replace-in-.env.local-only
# COSTWEAVE_TRAVELTOKEN_GPT_API_KEY=replace-in-.env.local-only
# COSTWEAVE_TRAVELTOKEN_CLAUDE_API_KEY=replace-in-.env.local-only
# Relay base URL is local-only as well (https required):
# COSTWEAVE_TRAVELTOKEN_BASE_URL=https://your-relay.example/v1
